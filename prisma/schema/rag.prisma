model DocumentEmbedding {
    id String @id @default(uuid(7))
    chunkKey String @unique
    sourceType String
    sourceId String
    sourceLabel String?
    content String
    metadata Json?

    embedding Unsupported("vector(384)")

    isDeleted Boolean @default(false)
    deletedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([sourceType], name: "idx_embedding_source_type")
    @@index([sourceId], name: "idx_embedding_source_id")
    @@index([chunkKey], name: "idx_embedding_chunk_key")

    @@map("document_embeddings")
}